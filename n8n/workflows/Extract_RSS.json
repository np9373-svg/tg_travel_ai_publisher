    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "587c63bc-e77b-453c-a4c6-2ffb46927d45",
              "name": "=raw_content",
              "value": "={{ $json.data.match(/(?:Content|Markdown Content|HTML Content):\\s*([\\s\\S]*)/)?.[1] }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        80,
        0
      ],
      "id": "b6e75b71-b756-43d5-8875-8aeb1036f78e",
      "name": "Extract_raw_content"
    },
    {
      "parameters": {
        "jsCode": "let text = $json.raw_content;\n\n// 1. Remove fenced code blocks ``` ```\ntext = text.replace(/```[\\s\\S]*?```/g, '');\n\n// 2. Remove inline code `code`\ntext = text.replace(/`[^`]*`/g, '');\n\n// 3. Remove markdown images ![alt](url)\ntext = text.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '');\n\n// 4. Remove markdown links [text](url) — полностью\ntext = text.replace(/\\[[^\\]]*\\]\\([^)]*\\)/g, '');\n\n// 5. Remove HTML tags\ntext = text.replace(/<[^>]+>/g, '');\n\n// 6. Decode basic HTML entities (минимально)\ntext = text\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&lt;/gi, '<')\n  .replace(/&gt;/gi, '>');\n\n// 7. Remove standalone URLs\ntext = text.replace(/https?:\\/\\/\\S+/gi, '');\n\nreturn [\n  {\n    json: {\n      text_stripped: text\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        20
      ],
      "id": "b40c2ea1-3722-4bf4-a1d3-eeae0d66e0a0",
      "name": "Strip_non_text_artefacts"
    },
    {
      "parameters": {
        "jsCode": "let text = $json.text_stripped;\n\n// 1. Normalize line breaks (CRLF, CR → LF)\ntext = text.replace(/\\r\\n/g, '\\n').replace(/\\r/g, '\\n');\n\n// 2. Replace tabs with spaces\ntext = text.replace(/\\t/g, ' ');\n\n// 3. Trim spaces at line start/end\ntext = text\n  .split('\\n')\n  .map(line => line.trim())\n  .join('\\n');\n\n// 4. Collapse multiple empty lines into max 2\ntext = text.replace(/\\n{3,}/g, '\\n\\n');\n\n// 5. Collapse multiple spaces inside lines\ntext = text.replace(/ {2,}/g, ' ');\n\n// 6. Remove lines that are only punctuation/symbols\ntext = text\n  .split('\\n')\n  .filter(line => /[a-zA-Zа-яА-Я0-9]/.test(line))\n  .join('\\n');\n\nreturn [\n  {\n    json: {\n      text_normalized: text\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        40
      ],
      "id": "bf418c01-f40c-42a5-a485-0890793a57ba",
      "name": "Normolize_text"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.text_normalized;\n\n// Split by newline into lines\nconst lines = text\n  .split('\\n')\n  .map(line => line.trim())\n  .filter(line => line.length > 0);\n\nreturn [\n  {\n    json: {\n      lines\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        100
      ],
      "id": "0b071db0-6208-4882-a598-e592338dbb51",
      "name": "Split_into_lines"
    },
    {
      "parameters": {
        "jsCode": "const lines = $json.lines;\n\nconst MIN_LENGTH = 25;     // символы\nconst MIN_WORDS = 5;       // слова\nconst MIN_LETTER_RATIO = 0.6;\n\nfunction isAllCaps(line) {\n  const letters = line.match(/[a-zA-Zа-яА-Я]/g);\n  if (!letters) return false;\n  return letters.every(ch => ch === ch.toUpperCase());\n}\n\nfunction isTitleCase(line) {\n  const words = line.split(' ');\n  if (words.length < 3) return false;\n\n  const capitalized = words.filter(w =>\n    /^[A-ZА-Я][a-zа-я]/.test(w)\n  );\n\n  return capitalized.length / words.length > 0.8;\n}\n\nfunction hasSentencePunctuation(line) {\n  return /[.!?…]$/.test(line);\n}\n\nfunction letterRatio(line) {\n  const letters = line.match(/[a-zA-Zа-яА-Я]/g) || [];\n  return letters.length / line.length;\n}\n\nconst good_lines = lines.filter(line => {\n  // 1. Length\n  if (line.length < MIN_LENGTH) return false;\n\n  // 2. Word count\n  const words = line.split(/\\s+/);\n  if (words.length < MIN_WORDS) return false;\n\n  // 3. Sentence punctuation\n  if (!hasSentencePunctuation(line)) return false;\n\n  // 4. Letter ratio\n  if (letterRatio(line) < MIN_LETTER_RATIO) return false;\n\n  // 5. Heading-like lines\n  if (isAllCaps(line)) return false;\n  if (isTitleCase(line)) return false;\n\n  return true;\n});\n\nreturn [\n  {\n    json: {\n      good_lines\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        180
      ],
      "id": "480f2fff-195c-4fd3-83b1-96882051fb51",
      "name": "Filter_noisy_lines"
