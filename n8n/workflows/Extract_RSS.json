    {
      "parameters": {
        "jsCode": "const items = $items();\n\n// 2. Функция валидации\nfunction isValid(item) {\n  const { title, pubDate, link } = item.json;\n\n  return [title, pubDate, link].every(\n    v => v !== undefined && v !== null && String(v).trim() !== ''\n  );\n}\n\n// 3. Фильтруем валидные\nconst validItems = items.filter(isValid);\n\n// 4. Если валидных не осталось — это ошибка\nif (validItems.length === 0) {\n  return {error: \"data_spoilt\"};\n}\n\n// 5. Возвращаем только валидные\nreturn validItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1500,
        -60
      ],
      "id": "59687964-fc85-4b46-8766-8ec089a278fa",
      "name": "Filter_spoilt_data",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $items();\n\n// 2. Функция фильтрации\nfunction isValid(item) {\n  const { published_at, filter_date } = item.json;\n\n  const publishedDate = new Date(published_at);\n  const filterDate = new Date(filter_date);\n\n   return publishedDate > filterDate;;\n}\n\n// 3. Фильтруем items\nconst validItems = items.filter(isValid);\n\n// 4. Если валидных не осталось — это ошибка\nif (validItems.length === 0) {\n  return {error: \"no_data_found\"};\n}\n\n// 5. Возвращаем только валидные\nreturn validItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1260,
        -180
      ],
      "id": "b0d7b306-baa6-4cd7-bca8-814e4bf1b9ec",
      "name": "Filter_old_news"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "63df8e99-6094-42ac-8c9d-9e2ea3147c12",
              "name": "published_at",
              "value": "={{\n  (() => {\n    const v = $json.pubDate || $json.isoDate;\n    if (!v) return null;\n\n    let dt;\n\n    if (typeof v === 'number') {\n      dt = v > 1e12\n        ? DateTime.fromMillis(v)\n        : DateTime.fromSeconds(v);\n    } else {\n      dt = DateTime.fromISO(v);\n      if (!dt.isValid) {\n        dt = DateTime.fromRFC2822(v);\n      }\n    }\n\n    return dt.isValid\n      ? dt.setZone('Europe/Moscow').toISO()\n      : null;\n  })()\n}}",
              "type": "string"
            },
            {
              "id": "2313887e-9a04-4a0b-8778-d00dc6847047",
              "name": "filter_date",
              "value": "={{ \n  DateTime\n    .now()\n    .setZone('Europe/Moscow')\n    .minus({ days: 1 })\n    .startOf('day')\n    .toISO()\n}}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "selected",
        "includeFields": "title, link, error",
        "options": {}
