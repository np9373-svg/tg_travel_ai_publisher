      "parameters": {
        "jsCode": "// Берём список из Set node\nconst categories = $input.first().json.categories;\n\n// Получаем \"память\" workflow (ПРАВИЛЬНЫЙ СПОСОБ)\nconst staticData = $getWorkflowStaticData('global');\n\n// Инициализация при первом запуске\nif (staticData.lastIndex === undefined) {\n  staticData.lastIndex = -1;\n}\n\n// Считаем следующий индекс по кругу\nconst nextIndex = (staticData.lastIndex + 1) % categories.length;\n\n// Сохраняем индекс для следующего запуска\nstaticData.lastIndex = nextIndex;\n\n// Возвращаем выбранный объект\nreturn [\n  {\n    json: categories[nextIndex]\n  }\n];\n"
      },
